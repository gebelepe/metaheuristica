    {% if algorithm == 'MFO' %}
    (function renderSpiral() {
        const b = {{ params.get('Constante Espiral', 1.0)
    }};
    const xSpiral = [], ySpiral = [];

    // Generamos la espiral de afuera hacia adentro (t de 1 a -1)
    for (let i = 0; i <= 200; i++) {
        const t = 1 - (i / 200) * 2;
        const r = Math.exp(b * t); // Radio logarítmico
        const theta = 2 * Math.PI * 2 * t; // 2 vueltas completas

        xSpiral.push(r * Math.cos(theta));
        ySpiral.push(r * Math.sin(theta));
    }

    // El trazo de la espiral con su área de influencia
    const traceSpiral = {
        x: xSpiral,
        y: ySpiral,
        mode: 'lines',
        fill: 'toself',
        fillcolor: 'rgba(255, 193, 7, 0.2)', // Ámbar traslúcido
        line: { color: '#ffc107', width: 3, shape: 'spline' },
