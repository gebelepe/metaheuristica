    // Function to handle client-side table sorting
    function sortTable(tbodyId, colIndex, type, headerElement) {
        const tbody = document.getElementById(tbodyId);
        if (!tbody) return;

        // CRITICAL FIX: Use .children instead of querySelectorAll('tr'). 
        // This ensures we ONLY sort the main machine rows, completely ignoring the nested task tables!
        const rows = Array.from(tbody.children);

        // Determine sort direction
        const isAsc = headerElement.getAttribute('data-dir') === 'asc';
        const direction = isAsc ? -1 : 1;
        headerElement.setAttribute('data-dir', isAsc ? 'desc' : 'asc');

        // Visual update: Reset all icons, then highlight the active one
        const icon = headerElement.querySelector('i');
        if (icon) {
            headerElement.parentElement.querySelectorAll('i').forEach(i => {
                i.className = 'bi bi-arrow-down-up ms-1 text-muted'; // Reset
            });
            icon.className = isAsc ? 'bi bi-arrow-down ms-1 text-primary' : 'bi bi-arrow-up ms-1 text-primary';
        }

        // Sort the rows
        rows.sort((a, b) => {
            const cellA = a.children[colIndex];
            const cellB = b.children[colIndex];

            if (!cellA || !cellB) return 0;

            // Use the 'data-sort' attribute you set in your Jinja template!
            const valA = cellA.hasAttribute('data-sort') ? cellA.getAttribute('data-sort') : cellA.innerText.trim();
            const valB = cellB.hasAttribute('data-sort') ? cellB.getAttribute('data-sort') : cellB.innerText.trim();

            if (type === 'num') {
                return (parseFloat(valA) - parseFloat(valB)) * direction;
            }
            return valA.localeCompare(valB) * direction;
        });

        // Re-append the rows to the table in their new order
        rows.forEach(row => tbody.appendChild(row));
    }

function toggleTableExpand(cardId, iconId, contractHeight = '60vh', expandHeight = '110vh') {
    const card = document.getElementById(cardId);
    const icon = document.getElementById(iconId);
    if (!card || !icon) return;

    const isExpanded = card.getAttribute('data-expanded') === 'true';

    if (!isExpanded) {
        // EXPANDING: smoothly increase the ceiling to 110vh
        card.style.maxHeight = expandHeight;
        card.setAttribute('data-expanded', 'true');
        icon.classList.replace('bi-arrows-angle-expand', 'bi-arrows-angle-contract');
    } else {
        // CONTRACTING: smoothly lower the ceiling back to 60vh
        card.style.maxHeight = contractHeight;
        card.setAttribute('data-expanded', 'false');
        icon.classList.replace('bi-arrows-angle-contract', 'bi-arrows-angle-expand');
    }

    // CRITICAL: Plotly needs a moment for the CSS transition to finish 
    // before it recalculates its own size.
    setTimeout(() => {
        window.dispatchEvent(new Event('resize'));
    }, 310);
}

