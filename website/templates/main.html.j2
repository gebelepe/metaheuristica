{% extends "base.html.j2" %}
{% block title %}Metaheuristica{% endblock %}
{% block content %}


<div class="container mt-3 mt-md-5 pt-3 pt-md-5">
    {% if error %}
  <div class="alert alert-danger text-center">
    {{ error }}
  </div>
  {% endif %}
  <h2 class="mb-4 text-center">Parámetros</h2>
  <form action="/run_algorithm" method="post">

    <!-- Selector de algoritmo -->
    <div class="mb-3">
      <label class="form-label">Algoritmo Metaheurístico</label>
      <select class="form-select" id="algorithm" name="algorithm" required>
        <option value="GA">Algoritmo Genético (GA)</option>
        <option value="ACO">Colonia de Hormigas (ACO)</option>
        <option value="PSO">Enjambre de Partículas (PSO)</option>
        <option value="AIS">Sistema Inmune Artificial (AIS)</option>
        <option value="DE">Diferencial Evolutivo (DE)</option>
        <option value="MFO">Polilla-Llama (MFO)</option> </select>
      </select>
    </div>

  <div id="algorithm-params"></div>

<div class="mb-4">
  <label class="form-label fw-bold"><i class="bi bi-layers-half"></i> Tipo de Problema</label>
  <select class="form-select form-select-lg border-primary shadow-sm" id="problem_type" name="problem_type" onchange="updateUIForProblemType(this.value)">
    <optgroup label="Optimización Matemática">
      <option value="Func">Función</option>
    </optgroup>
            <optgroup label="Problemas Binarios">
    <option value="KnS">Knapsack</option>
    </optgroup>
    <optgroup label="Problemas Combinatorios">
          <option value="JobS">Job-Shop Problem Simplificado (JSP)</option>
      <option value="TSP">Problema del Viajante (TSP)</option>
    </optgroup>

  </select>
</div>

<div id="scheduling-problem-group" style="display:none;" class="mb-3">
    <div class="card p-3 shadow-sm border-jobs">
        <label class="form-label fw-bold"><i class="bi bi-clock-history"></i> Gestión de Tareas y Máquinas</label>
        <small class="text-muted">Simple refiere al Relaxed Job-Shop Problem, donde cada maquina puede hacer cualquier tarea y todas tienen la misma capacidad de procesamiento.</small>
        <div class="input-group mb-3">
            <span class="input-group-text">Máquinas</span>
            <input type="number" id="scheduling_machines" name="scheduling_machines" class="form-control" value="" min="1" max="100">
            
            <span class="input-group-text">Nº Tareas</span>
            <input type="number" id="taskCount" class="form-control" value="" min="1" max="1000">
            
            <button class="btn btn-jobs" type="button" onclick="generateRandomScheduling()">
                <i class="bi bi-shuffle"></i> Generar Azar
            </button>
        </div>

        <label class="form-label small fw-bold">Lista de Tareas (Nombre, Duración)</label>
        <textarea class="form-control" name="scheduling_tasks" id="scheduling_tasks" rows="6" 
                  placeholder="Tarea_1, 10&#10;Tarea_2, 25"></textarea>
        <small class="text-muted">Se generarán tareas con duraciones aleatorias basadas en la cantidad indicada.</small>
    </div>
</div>

<div id="math-problem-group">
    <div class="mb-3">
      <label class="form-label fw-bold">Función Objetivo</label>
      
      <div id="math-preview-container" class="text-center p-3 mb-2 border rounded bg-light" 
           style="min-height: 80px; display: flex; align-items: center; justify-content: center;">
        <div id="math-preview">$$f(x, y) = ...$$</div>
      </div>

      <input type="text" class="form-control form-control-lg" value = "x**2 + y**2" id="function" name="function"
             placeholder="Ejemplo: x**2 + y**2" oninput="renderMath()">
      <small class="text-muted">Notación Sympy: x**2, cos(x), etc.</small>
    </div>

    <div class="mb-3 d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-func" 
              onclick="setFunction('x**2 + y**2')">Parabólica</button>

      <button type="button" class="btn btn-func" 
              onclick="setFunction('(x**2 + 10*sin(x)) + (y**2 + 10*sin(y))')">Seno simple</button>

      <button type="button" class="btn btn-func" 
              onclick="setFunction('20 + (x**2 - 10*cos(2*pi*x)) + (y**2 - 10*cos(2*pi*y))')">Rastrigin</button>

      <button type="button" class="btn btn-func" 
              onclick="setFunction('1 + (x**2 + y**2)/4000 - cos(x/sqrt(1)) * cos(y/sqrt(2))')">Griewank</button>
    </div>

    <div class="mb-3">
      <div class="form-check form-switch fancy-switch">
        <input class="form-check-input" type="checkbox" id="dimSwitch">
        <label class="form-check-label" for="dimSwitch" id="dimLabel">1 Dimensión</label>
        <input type="hidden" id="dimValue" name="dim" value="1">
      </div>
    </div>
</div>

<div id="knapsack-problem-group" style="display:none;" class="mb-3">
    <div class="card p-3 shadow-sm border-kns">
        <label class="form-label fw-bold"><i class="bi bi-bag-fill"></i> Gestión de la Mochila</label>
        
        <div class="input-group mb-3">
            <span class="input-group-text">Capacidad (kg)</span>
            <input type="number" id="knapsack_capacity" name="knapsack_capacity" class="form-control" value="" min="1">
            
            <span class="input-group-text">Nº Objetos</span>
            <input type="number" id="itemCount" class="form-control" value="" min="1" max="1000">
            
            <button class="btn btn-kns" type="button" onclick="generateRandomItems()">
                <i class="bi bi-shuffle"></i> Generar Azar
            </button>
        </div>

        <label class="form-label small fw-bold">Elementos (Nombre, Valor, Peso)</label>
        <textarea class="form-control" name="knapsack_items" id="knapsack_items" rows="6" 
                  placeholder="Brújula, 40, 2&#10;Saco, 100, 5"></textarea>
        <small class="text-muted">Formato: Nombre, Valor, Peso (uno por línea).</small>
    </div>
</div>





  <div id="tsp-problem-group" style="display:none;" class="mb-3">
    <div class="card p-3 shadow-sm border-tsp">
      <label class="form-label fw-bold text-tsp">Gestión de Ciudades</label>
      
      <div class="input-group mb-3">
        <span class="input-group-text">Nº de Ciudades</span>
        <input type="number" id="randomCityCount" class="form-control" value="10" min="3">
        <button class="btn btn-tsp" type="button" onclick="generateRandomCities()">
          <i class="bi bi-shuffle"></i> Generar Azar
        </button>
      </div>

      <label class="form-label">Coordenadas de Ciudades (x,y)</label>
      <textarea class="form-control" name="tsp_cities" id="tsp_cities" rows="6" 
                placeholder="0,0&#10;10,20&#10;50,10&#10;30,40"></textarea>
      <small class="text-muted">Formato: x,y (una por línea). Límites sugeridos: 0 a 100.</small>
    </div>
  </div>

      <div id="optimization-type-group" class="mb-3">
      <div class="form-check form-switch fancy-switch">
        <input class="form-check-input" type="checkbox" id="optSwitch">
        <label class="form-check-label" for="optSwitch" id="optLabel">Minimización</label>
        <input type="hidden" id="optValue" name="optimization_type" value="min">
      </div>
    </div>

    
    <!-- Límites -->
  <div id="limit-group" class="mb-3"> 
      <div class="row">
        <div class="col-12 col-md-6 mb-3 mb-md-0">
          <label class="form-label">Límite inferior</label>
          <input type="number" class="form-control" id="lb" name="lb" value="-5">
        </div>
        <div class="col-12 col-md-6">
          <label class="form-label">Límite superior</label>
          <input type="number" class="form-control" id="ub" name="ub" value="5">
        </div>
      </div>
  </div>

    <!-- Contenedor dinámico de parámetros -->


    <!-- Botón enviar -->
    <div class="mb-3 text-center">
      <button type="submit" class="btn btn-success">Ejecutar</button>
    </div>
  </form>
</div>

<script>

  function setFunction(expr) {
    document.getElementById('function').value = expr;
  }

  dimSwitch.addEventListener('change', function() {
    if (this.checked) {
      dimValue.value = 2;
      dimLabel.textContent = "2 Dimensiones";
    } else {
      dimValue.value = 1;
      dimLabel.textContent = "1 Dimensión";
    }
  });

  const algorithmSelect = document.getElementById('algorithm');
  const paramsContainer = document.getElementById('algorithm-params');

  // 1. Definimos la función de renderizado
  function updateAlgorithmParams() {
    const algo = algorithmSelect.value;
    paramsContainer.innerHTML = '';

    if (algo === 'GA') {
      paramsContainer.innerHTML = `
        <h4 class="mt-4">Parámetros GA</h4>
        <div class="mb-3"><label class="form-label">Tamaño de población</label><input type="number" step="10" class="form-control" name="ga_population" value="100"></div>
        <div class="mb-3"><label class="form-label">Tasa de mutación</label><input type="number" step="0.1" class="form-control" name="ga_mutation" value="0.3"></div>
        <div class="mb-3"><label class="form-label">Tasa de cruza</label><input type="number" step="0.1" class="form-control" name="ga_crossover" value="0.7"></div>
        <div class="mb-3"><label class="form-label">Número de generaciones</label><input type="number" class="form-control" name="ga_generations" value="200"></div>
      `;
    }
    // [...] Etiquetas para todos los temas algoritmos [...]
    else if (algo === 'ACO') {
      paramsContainer.innerHTML = `
        <h4 class="mt-4">Parámetros ACO</h4>
        <div class="mb-3"><label class="form-label">Número de hormigas</label><input type="number" step="10" class="form-control" name="aco_ants" value="50"></div>
        <div class="mb-3"><label class="form-label">α (feromona)</label><input type="number" step="0.1" class="form-control" name="aco_alpha" value="1"></div>
        <div class="mb-3"><label class="form-label">β (heurística)</label><input type="number" step="0.1" class="form-control" name="aco_beta" value="2"></div>
        <div class="mb-3"><label class="form-label">Tasa de evaporación</label><input type="number" step="0.1" class="form-control" name="aco_evaporation" value="0.3"></div>
        <div class="mb-3"><label class="form-label">Número de iteraciones</label><input type="number" class="form-control" name="aco_iterations" value="100"></div>
      `;
    } else if (algo === 'PSO') {
      paramsContainer.innerHTML = `
        <h4 class="mt-4">Parámetros PSO</h4>
        <div class="mb-3"><label class="form-label">Número de partículas</label><input type="number" step="10" class="form-control" name="pso_particles" value="50"></div>
        <div class="mb-3"><label class="form-label">Coeficiente cognitivo (C1)</label><input type="number" step="0.1" class="form-control" name="pso_c1" value="1.5"></div>
        <div class="mb-3"><label class="form-label">Coeficiente social (C2)</label><input type="number" step="0.1" class="form-control" name="pso_c2" value="1.5"></div>
        <div class="mb-3"><label class="form-label">Factor de inercia (w)</label><input type="number" step="0.1" class="form-control" name="pso_w" value="0.9"></div>
        <div class="mb-3"><label class="form-label">Número de iteraciones</label><input type="number" class="form-control" name="pso_iterations" value="100"></div>
      `;
    } else if (algo === 'AIS') {
      paramsContainer.innerHTML = `
        <h4 class="mt-4">Parámetros AIS</h4>
        <div class="mb-3"><label class="form-label">Número de anticuerpos</label><input type="number" step="10" class="form-control" name="ais_antibodies" value="100"></div>
        <div class="mb-3"><label class="form-label">Tasa de clonación</label><input type="number" step="0.1" class="form-control" name="ais_cloning" value="3"></div>
        <div class="mb-3"><label class="form-label">Parámetro α</label><input type="number" step="0.1" class="form-control" name="ais_alpha" value="2"></div>
        <div class="mb-3"><label class="form-label">Parámetro β</label><input type="number" step="0.1" class="form-control" name="ais_beta" value="1"></div>
        <div class="mb-3"><label class="form-label">Número de iteraciones</label><input type="number" class="form-control" name="ais_iterations" value="100"></div>
      `;
    } else if (algo === 'DE') {
      paramsContainer.innerHTML = `
        <h4 class="mt-4">Parámetros DE</h4>
        <div class="mb-3"><label class="form-label">Tamaño de población</label><input type="number" step="10" class="form-control" name="de_population" value="60"></div>
        <div class="mb-3"><label class="form-label">Factor de mutación (F)</label><input type="number" step="0.1" class="form-control" name="de_mutation" value="0.9"></div>
        <div class="mb-3"><label class="form-label">Tasa de cruza (CR)</label><input type="number" step="0.1" class="form-control" name="de_crossover" value="0.5"></div>
        <div class="mb-3"><label class="form-label">Número de iteraciones</label><input type="number" class="form-control" name="de_iterations" value="100"></div>
      `;
    } else if (algo === 'MFO') {
      paramsContainer.innerHTML = `
        <h4 class="mt-4">Parámetros MFO</h4>
        <div class="mb-3">
          <label class="form-label">Número de Polillas (N)</label>
          <input type="number" step="10" class="form-control" name="mfo_particles" value="50">
        </div>
        <div class="mb-3">
          <label class="form-label">Número de iteraciones</label>
          <input type="number" class="form-control" name="mfo_iterations" value="100">
        </div>
        <div class="mb-3">
          <label class="form-label">Constante de forma de espiral (b)</label>
          <input type="number" step="0.1" class="form-control" name="mfo_b" value="1.0">
        </div>
        <div class="mb-3">
          <label class="form-label">Modo de Selección de Flama</label>
          <select class="form-select" name="mfo_selection">
            <option value="Adaptativo">Adaptativo (i % flame_no)</option>
            <option value="Mejor Flama">Mejor Flama</option>
            <option value="Peor Flama">Peor Flama</option>
          </select>
        </div>
      `;
    }
  }

  // 2. Escuchar cambios manuales
  algorithmSelect.addEventListener('change', updateAlgorithmParams);

  // 3. FORZAR ejecución al cargar la página
  document.addEventListener('DOMContentLoaded', function() {
    updateAlgorithmParams(); // Renderiza los parámetros del algoritmo por defecto
    renderMath();            // Opcional: renderiza el preview de la función inicial
  });

  const optSwitch = document.getElementById('optSwitch');
  const optLabel = document.getElementById('optLabel');
  const optValue = document.getElementById('optValue');

  optSwitch.addEventListener('change', function() {
    if (this.checked) {
      optValue.value = "max";
      optLabel.textContent = "Maximización";
    } else {
      optValue.value = "min";
      optLabel.textContent = "Minimización";
    }
  });

function generateRandomScheduling() {
    const taskTextArea = document.getElementById('scheduling_tasks');
    const machineInput = document.getElementById('scheduling_machines');
    const taskCountInput = document.getElementById('taskCount');
    
    // 1. Generar número de máquinas al azar (entre 2 y 5)
    if (!machineInput.value) {
        machineInput.value = Math.floor(Math.random() * 5) + 2;
    }

    if (!taskCountInput.value) {
        taskCountInput.value = Math.floor(Math.random() * 10) + 5;
    }

    const taskCount = parseInt(taskCountInput.value, 10);

    let taskList = [];
    const nombres = ['Tarea', 'Job', 'Proceso', 'Carga', 'Fix'];
    
    for (let i = 1; i <= taskCount; i++) {
        const nombreAleatorio = nombres[Math.floor(Math.random() * nombres.length)];
        const duracion = Math.floor(Math.random() * 41) + 5; // Duración entre 5 y 45
        taskList.push(`${nombreAleatorio} ${i}, ${duracion}`);
    }

    // 3. Insertar en el textarea
    taskTextArea.value = taskList.join('\n');
}

function updateUIForProblemType(type) {
    const tspGroup = document.getElementById('tsp-problem-group');
    const limgroup = document.getElementById('limit-group');
    const schedulingGroup = document.getElementById('scheduling-problem-group');
    const mathGroup = document.getElementById('math-problem-group');
    const knapsackGroup = document.getElementById('knapsack-problem-group');
    const lbInput = document.getElementById('lb');
    const ubInput = document.getElementById('ub');
    const machineInput = document.getElementById('scheduling_machines');
    const taskCountInput = document.getElementById('taskCount');
    const itemCount = document.getElementById('itemCount');
    const knapSackSize = document.getElementById('knapsack_capacity');
    // Reset de visibilidad de los grupos de problema
    tspGroup.style.display = 'none';
    schedulingGroup.style.display = 'none';
    mathGroup.style.display = 'none';
    knapsackGroup.style.display = 'none';
    lbInput.disabled = false;
    ubInput.disabled = false;
    machineInput.value = null;
    taskCountInput.value = null;
    itemCount.value = null;
    knapSackSize.value = null;
    document.getElementById('optSwitch').checked = false;
    document.getElementById('optSwitch').dispatchEvent(new Event('change'));

    // Dentro de updateUIForProblemType(type)...


    // Lógica de límites (se oculta en Bits, Mochila y Scheduling)
    if (type === 'KnS' || type === 'JobS') {
        limgroup.style.display = 'none';
    } else {
        limgroup.style.display = 'block';
    }

    if (type === 'JobS') {
        schedulingGroup.style.display = 'block';
        generateRandomScheduling()
    }
    else if (type === 'Func') {
        mathGroup.style.display = 'block';
        lbInput.disabled = false;
        ubInput.disabled = false;
        lbInput.value = -5;
        ubInput.value = 5;
    } 
    else if (type === 'KnS') {
        knapsackGroup.style.display = 'block';
        lbInput.value = 0;
        ubInput.value = 1;
        lbInput.disabled = true;
        ubInput.disabled = true;
        document.getElementById('optSwitch').checked = true;
        document.getElementById('optSwitch').dispatchEvent(new Event('change'));
        generateRandomItems()

    } 
    else if (type === 'TSP') {
        tspGroup.style.display = 'block';
        lbInput.disabled = false;
        ubInput.value = 100;
        lbInput.value = 0;
        generateRandomCities()
    }

}

function generateRandomItems() {
    const itemTextArea = document.getElementById('knapsack_items');
    const itemCountInput = document.getElementById('itemCount');
    const knapSackCapacity = document.getElementById('knapsack_capacity');

    if (!itemCountInput.value) {
        itemCountInput.value = (Math.floor(Math.random() * 10) + 2);
    }

      if (!knapSackCapacity.value) {
        knapSackCapacity.value = (Math.floor(Math.random() *itemCountInput.value)+3)*10;
    }

    const numItems = parseInt(itemCountInput.value);
    
    if (isNaN(numItems) || numItems < 1) {
        alert("Por favor, ingresa una cantidad válida de objetos.");
        return;
    }

    const nombres = ['Mapa', 'Cuerda', 'Tienda', 'Agua', 'Linterna', 'Batería', 'Botas', 'Manta', 'Radio', 'Herramienta'];
    let itemList = [];

    for (let i = 1; i <= numItems; i++) {
        const nombreBase = nombres[(i-1) % nombres.length];
        const nombre = numItems > 10 ? `${nombreBase}_${i}` : nombreBase;
        
        // --- LÓGICA DE INTERVALOS ---
        
        // Valor: Genera entre 1 y 10, luego multiplica por 10 (Resultados: 10, 20, ..., 100)
        const valor = (Math.floor(Math.random() * 10) + 1) * 10;
        
        // Peso: Genera entre 1 y 6, luego multiplica por 5 (Resultados: 5, 10, ..., 30)
        const peso = (Math.floor(Math.random() * 6) + 1) * 5;
        
        itemList.push(`${nombre}, ${valor}, ${peso}`);
    }

    itemTextArea.value = itemList.join('\n');
}
function generateRandomCities() {
    const textArea = document.getElementById('tsp_cities');
    const cityInput = document.getElementById('randomCityCount');
    const lbEl = document.getElementById('lb');
    const ubEl = document.getElementById('ub');

    if (!cityInput.value){
      cityInput.value = (Math.floor(Math.random() * 10) + 2);
    }
    

    // Validación: Si los elementos no existen en el DOM, salimos de la función sin error
    if (!lbEl || !ubEl) {
        console.error("No se encontraron los inputs de límites (lb o ub) con ese ID.");
        return;
    }

    const count = parseInt(cityInput.value);
    const min = parseFloat(lbEl.value);
    const max = parseFloat(ubEl.value);
  
    if (isNaN(count) || count < 3) {
        alert("Por favor, ingresa al menos 3 ciudades.");
        return;
    }

    if (min >= max) {
        alert("El límite inferior debe ser menor al superior.");
        return;
    }

    let cityList = [];
    for (let i = 0; i < count; i++) {
        // Generamos números aleatorios dentro del rango [min, max]
        const x = Math.floor(Math.random() * (max - min + 1)) + min;
        const y = Math.floor(Math.random() * (max - min + 1)) + min;
        cityList.push(`${x},${y}`);
    }

    textArea.value = cityList.join('\n');
}

function renderMath() {
    let input = document.getElementById('function').value;
    const preview = document.getElementById('math-preview');
    
    // Seguridad: si termina en operador, no renderizar aún
    if (input.match(/[+\-*/]$/)) return; 

    let latex = input
        .replace(/\*\*/g, "^")
        .replace(/\*/g, "\\cdot ")
        .replace(/pi/g, "\\pi")
        .replace(/\//g, "\\div ");


    // Funciones con llaves normales
    latex = latex.replace(/sqrt\(([^)]+)\)/g, "\\sqrt{($1)}");
    // Funciones trigonométricas
    latex = latex.replace(/sin\(([^)]+)\)/g, "\\sin{($1)}");
    latex = latex.replace(/cos\(([^)]+)\)/g, "\\cos{($1)}");
    latex = latex.replace(/tan\(([^)]+)\)/g, "\\tan{($1)}");
    latex = latex.replace(/sec\(([^)]+)\)/g, "\\sec{($1)}");
    latex = latex.replace(/csc\(([^)]+)\)/g, "\\csc{($1)}");
    latex = latex.replace(/cot\(([^)]+)\)/g, "\\cot{($1)}");


    // Usar corchetes como delimitadores de bloque
    preview.innerHTML = `\\[f(x, y) = ${latex}\\]`;
    MathJax.typesetPromise([preview]);
}



  // Ensure the preset buttons also update the top render
  function setFunction(expr) {
    document.getElementById('function').value = expr;
    renderMath();
  }
</script>

<style>
  /* Reglas responsivas */
  @media (max-width: 576px) {
    h2 { font-size: 1.5rem; }
    .form-control { font-size: 0.9rem; }
    .btn-sm { width: 100%; }
  }
  @media (min-width: 577px) and (max-width: 768px) {
    h2 { font-size: 1.75rem; }
    .btn-sm { flex: 1; }
  }
  @media (min-width: 769px) {
    h2 { font-size: 2rem; }
  }

  #math-preview-container {
  background: linear-gradient(145deg, #f8f9fa, #e9ecef);
  box-shadow: inset 2px 2px 5px #d1d9e6, inset -2px -2px 5px #ffffff;
  transition: all 0.3s ease;
  }

  #math-preview {
    font-size: 1.4rem;
    color: #2c3e50;
    max-width: 100%;
    overflow-x: auto; /* Adds scrollbar if formula is too wide for mobile */
  }
  select optgroup {
    font-size: 0.85rem;
    font-weight: bold;
    color: #6c757d;
    background-color: #f8f9fa;
}

</style>

{% endblock %}
